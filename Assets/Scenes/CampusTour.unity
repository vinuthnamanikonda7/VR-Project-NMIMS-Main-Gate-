  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CampusTour.CampusTourManager
  locations:
  - name: 'Location 1: Main Gate Outer Left'
    mediaFileName: Location1.jpg
    description: This perspective presents the left-side exterior vantage point of
      the SVKM NMIMS Main Gate, showing the outer approach road, perimeter security
      structures, and visitor pathways.
    hotspots:
    - type: 0
      title: Go to Location 2
      description: 
      targetLocationIndex: 1
      yaw: 35
      pitch: -4
      distance: 8
    - type: 0
      title: Go to Location 3
      description: 
      targetLocationIndex: 2
      yaw: 75
      pitch: -3
      distance: 8
    - type: 1
      title: Location 1 Overview
      description: Standing on the left side outside the SVKM NMIMS Main Gate. This
        area oversees the exterior campus boundary and entry lanes leading toward
        the central archway.
      targetLocationIndex: 0
      yaw: -35
      pitch: 2
      distance: 8
  - name: 'Location 2: Main Gate Outer Right'
    mediaFileName: Location2.jpg
    description: This view captures the right-side exterior of the SVKM NMIMS Main
      Gate, featuring the adjoining pedestrian walkway, outer perimeter landscaping,
      and vehicle checkout area.
    hotspots:
    - type: 0
      title: Go to Location 3
      description: 
      targetLocationIndex: 2
      yaw: 55
      pitch: -3
      distance: 8
    - type: 0
      title: Back to Location 1
      description: 
      targetLocationIndex: 0
      yaw: -160
      pitch: -3
      distance: 8
    - type: 1
      title: Location 2 Overview
      description: Standing on the right side outside the SVKM NMIMS Main Gate. This
        perspective highlights the right boundary wing and exterior pedestrian sidewalks.
      targetLocationIndex: 0
      yaw: -40
      pitch: 6
      distance: 7
  - name: 'Location 3: Main Gate Full Outer View'
    mediaFileName: Location3.jpg
    description: A comprehensive panoramic perspective capturing the full exterior
      view of the SVKM NMIMS Main Gate in its entirety, showcasing the grand institutional
      architecture and main entrance portal.
    hotspots:
    - type: 0
      title: Enter Campus (Loc 4)
      description: 
      targetLocationIndex: 3
      yaw: 0
      pitch: -3
      distance: 8
    - type: 0
      title: Go to Location 2
      description: 
      targetLocationIndex: 1
      yaw: -110
      pitch: -3
      distance: 8
    - type: 1
      title: Location 3 Overview
      description: A full exterior panoramic view of the SVKM NMIMS Main Gate, presenting
        the landmark front elevation, grand campus signage, and central entry thoroughfare.
      targetLocationIndex: 0
      yaw: -30
      pitch: 8
      distance: 7
  - name: 'Location 4: Main Gate Inner Left'
    mediaFileName: Location4.jpg
    description: Positioned just past the threshold, this view showcases the left
      side inside the SVKM NMIMS Main Gate, featuring the internal security control
      post and academic circulation boulevard.
    hotspots:
    - type: 0
      title: Go to Location 5
      description: 
      targetLocationIndex: 4
      yaw: 75
      pitch: -4
      distance: 8
    - type: 0
      title: Go to Location 6
      description: 
      targetLocationIndex: 5
      yaw: 30
      pitch: -3
      distance: 8
    - type: 0
      title: Exit to Outside (Loc 3)
      description: 
      targetLocationIndex: 2
      yaw: 180
      pitch: -3
      distance: 8
    - type: 1
      title: Location 4 Overview
      description: Standing on the left side inside the SVKM NMIMS Main Gate. This
        vantage point welcomes visitors into the interior campus avenue and internal
        security checkpoint.
      targetLocationIndex: 0
      yaw: -25
      pitch: 4
      distance: 7
  - name: 'Location 5: Main Gate Inner Right'
    mediaFileName: Location5.jpg
    description: Looking toward the right side inside the SVKM NMIMS Main Gate, overlooking
      internal service pathways, landscaped verges, and adjacent campus administrative
      facilities.
    hotspots:
    - type: 0
      title: Go to Location 6
      description: 
      targetLocationIndex: 5
      yaw: 60
      pitch: -4
      distance: 8
    - type: 0
      title: Back to Location 4
      description: 
      targetLocationIndex: 3
      yaw: -120
      pitch: -3
      distance: 8
    - type: 1
      title: Location 5 Overview
      description: Standing on the right side inside the SVKM NMIMS Main Gate. This
        area provides access along the right inner concourse and campus perimeter
        avenues.
      targetLocationIndex: 0
      yaw: -30
      pitch: 6
      distance: 7
  - name: 'Location 6: Main Gate Full Inner View'
    mediaFileName: Location6.jpg
    description: An expansive full internal view looking across the SVKM NMIMS Main
      Gate from within the campus grounds, demonstrating the complete courtyard expanse
      and academic quad gateway.
    hotspots:
    - type: 0
      title: Return to Location 1
      description: 
      targetLocationIndex: 0
      yaw: 180
      pitch: -4
      distance: 8
    - type: 0
      title: Back to Location 5
      description: 
      targetLocationIndex: 4
      yaw: -135
      pitch: -3
      distance: 8
    - type: 1
      title: Location 6 Overview
      description: A full internal panoramic perspective looking from inside the
        SVKM NMIMS Main Gate. It offers an unobstructed vista connecting the gate
        to inner university buildings.
      targetLocationIndex: 0
      yaw: -20
      pitch: 5
      distance: 7
